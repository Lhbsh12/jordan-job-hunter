# ==========================================
# Jordan Job Hunter - Environment Variables
# ==========================================
# Copy this file to .env to customize environment settings:
#   cp .env.example .env
#
# NOTE: All configuration can also be set directly inside the Web UI!
# Sensitive values in .env or data/profile.json are protected by .gitignore.

# Web Server Port
PORT=3000

# Optional: Default Email / SMTP Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-character-gmail-app-password
# SMTP_FROM_NAME=Your Full Name

# Optional: AI Provider Keys (if using LLM generation instead of local engine)
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434
